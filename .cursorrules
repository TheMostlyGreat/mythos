### Basic Responses API Usage

#### Simple Text Generation
```python
from openai import OpenAI

client = OpenAI()

# Basic request
response = client.responses.create(
    model="gpt-4.1",
    input="Explain quantum computing"
)
print(response.output_text)

# With system instructions
response = client.responses.create(
    model="gpt-4.1",
    input="What is machine learning?",
    instructions="Explain like I'm 5 years old"
)
```

#### Conversation Management
```python
# Automatic conversation state (recommended)
response1 = client.responses.create(
    model="gpt-4.1",
    input="What is AI?"
)

# Chain responses together
response2 = client.responses.create(
    model="gpt-4.1",
    previous_response_id=response1.id,
    input="How does it work?"
)

# Manual conversation state (when needed)
response = client.responses.create(
    model="gpt-4.1",
    input=[
        {"role": "system", "content": "You are a helpful assistant"},
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi! How can I help?"},
        {"role": "user", "content": "Tell me about AI"}
    ]
)
```

### Structured Outputs

#### JSON Schema Approach
```python
# Define strict JSON schema
schema = {
    "type": "object",
    "properties": {
        "steps": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "explanation": {"type": "string"},
                    "output": {"type": "string"}
                },
                "required": ["explanation", "output"],
                "additionalProperties": False
            }
        },
        "final_answer": {"type": "string"}
    },
    "required": ["steps", "final_answer"],
    "additionalProperties": False
}

response = client.responses.create(
    model="gpt-4.1",
    input="Solve 8x + 7 = -23",
    text={
        "format": {
            "type": "json_schema",
            "name": "math_solution",
            "schema": schema,
            "strict": True  # Ensures 100% compliance
        }
    }
)
```

#### Pydantic Integration (Recommended)
```python
from pydantic import BaseModel
from typing import List

class MathStep(BaseModel):
    explanation: str
    output: str

class MathSolution(BaseModel):
    steps: List[MathStep]
    final_answer: str

# Use parse method for automatic schema generation
response = client.responses.parse(
    model="gpt-4.1",
    input="Solve 8x + 7 = -23",
    instructions="Show step-by-step solution",
    text_format=MathSolution,
)

result = response.output[0].content[0].parsed
```

### Advanced Features

#### Built-in Tools
```python
# Web search
response = client.responses.create(
    model="gpt-4.1",
    tools=[{"type": "web_search_preview"}],
    input="What are the latest AI developments?"
)

# File search
response = client.responses.create(
    model="gpt-4.1",
    tools=[{
        "type": "file_search",
        "vector_store_ids": ["vs_abc123"]
    }],
    input="What does this document say about climate change?"
)

# Function calling
tools = [{
    "type": "function",
    "name": "get_weather",
    "description": "Get weather for a location",
    "parameters": {
        "type": "object",
        "properties": {
            "location": {"type": "string"}
        },
        "required": ["location"],
        "additionalProperties": False
    }
}]

response = client.responses.create(
    model="gpt-4.1",
    tools=tools,
    input="What's the weather in New York?"
)
```

#### Background Tasks & Streaming
```python
# Long-running background task
response = client.responses.create(
    model="o3",
    input="Write a detailed analysis of climate change",
    background=True
)

# Poll for completion
while response.status in {"queued", "in_progress"}:
    time.sleep(2)
    response = client.responses.retrieve(response.id)

# Streaming with resume capability
stream = client.responses.create(
    model="gpt-4.1",
    input="Tell me a story",
    stream=True
)

for event in stream:
    if event.type == 'response.output_text.delta':
        print(event.delta, end='')
```

#### Image Generation
```python
# Generate images in conversation
response = client.responses.create(
    model="gpt-4.1",
    input="Create an image of a sunset over mountains",
    tools=[{"type": "image_generation"}],
    default_headers={"x-ms-oai-image-generation-deployment": "gpt-image-1"}
)

# Streaming partial images
stream = client.responses.create(
    model="gpt-4.1",
    input="Draw a landscape",
    stream=True,
    tools=[{"type": "image_generation", "partial_images": 2}]
)

for event in stream:
    if event.type == "response.image_generation_call.partial_image":
        image_data = base64.b64decode(event.partial_image_b64)
        with open(f"partial_{event.partial_image_index}.png", "wb") as f:
            f.write(image_data)
```

#### File Input Support
```python
# PDF analysis via file ID
response = client.responses.create(
    model="gpt-4.1",
    input=[{
        "role": "user",
        "content": [
            {"type": "input_file", "file_id": "file-abc123"},
            {"type": "input_text", "text": "Summarize this document"}
        ]
    }]
)

# Base64 file input
with open("document.pdf", "rb") as f:
    base64_data = base64.b64encode(f.read()).decode()

response = client.responses.create(
    model="gpt-4.1",
    input=[{
        "role": "user",
        "content": [
            {
                "type": "input_file",
                "filename": "document.pdf",
                "file_data": f"data:application/pdf;base64,{base64_data}"
            },
            {"type": "input_text", "text": "Analyze this document"}
        ]
    }]
)
```

#### Model Context Protocol (MCP)
```python
# Connect to external tools via MCP
response = client.responses.create(
    model="gpt-4.1",
    tools=[{
        "type": "mcp",
        "server_label": "github",
        "server_url": "https://github-mcp-server.com",
        "headers": {"Authorization": "Bearer YOUR_TOKEN"},
        "require_approval": "never"
    }],
    input="Analyze this GitHub repository"
)

# Handle approval requests
if response.output and response.output[0].type == "mcp_approval_request":
    approval_response = client.responses.create(
        model="gpt-4.1",
        previous_response_id=response.id,
        input=[{
            "type": "mcp_approval_response",
            "approve": True,
            "approval_request_id": response.output[0].id
        }]
    )
```

### Migration from Chat Completions

#### API Endpoint Changes
| Feature | Chat Completions | Responses API |
|---------|------------------|---------------|
| Endpoint | `/v1/chat/completions` | `/v1/responses` |
| Context | Manual messages array | Automatic or chaining |
| Tools | Basic function calling | Built-in + function calling |
| Streaming | Basic chunks | Enhanced with sequence numbers |
| Background | Not supported | Full async support |
| Files | Separate upload/reference | Direct file input |

#### Code Migration Examples
```python
# OLD: Chat Completions (❌ Don't use)
response = openai.chat.completions.create(
    model="gpt-4",
    messages=[{"role": "user", "content": "Hello"}]
)
content = response.choices[0].message.content

# NEW: Responses API (✅ Use this)
response = client.responses.create(
    model="gpt-4.1",
    input="Hello"
)
content = response.output_text

# OLD: Manual conversation management
messages = [
    {"role": "system", "content": "You are helpful"},
    {"role": "user", "content": "Hi"},
    {"role": "assistant", "content": "Hello!"},
    {"role": "user", "content": "How are you?"}
]

# NEW: Automatic context or chaining
response1 = client.responses.create(model="gpt-4.1", input="Hi")
response2 = client.responses.create(
    model="gpt-4.1",
    previous_response_id=response1.id,
    input="How are you?"
)
```

