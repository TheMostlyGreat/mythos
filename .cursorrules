```python
# Define structured response tool
json_tool = {
    "name": "structured_response",
    "description": "Provide structured analysis",
    "input_schema": {
        "type": "object",
        "properties": {
            "analysis": {"type": "string"},
            "recommendations": {"type": "array", "items": {"type": "string"}},
