## Code Standards

### API Call Pattern
```python
# Standard pattern for all API calls
def make_api_call(
    provider: str,
    model: str,
    prompt: str,
    system_prompt: str = None,
    **kwargs
) -> Dict[str, Any]:
    """
    Standard API call pattern with proper error handling.
    
    Args:
        provider: 'openai' or 'anthropic'
        model: Model name to use
        prompt: User input/question
        system_prompt: System instructions (optional)
        **kwargs: Additional provider-specific parameters
    
    Returns:
        Parsed response content
    """
    if provider == "openai":
        return _call_openai_responses_api(
            model=model,
            input=prompt,
            instructions=system_prompt,
            **kwargs
        )
    elif provider == "anthropic":
        return _call_anthropic_messages_api(
            model=model,
            prompt=prompt,
            system=system_prompt,
            **kwargs
        )
    else:
        raise ValueError(f"Unsupported provider: {provider}")
```

### Error Handling Requirements
```python
# Required error handling for all API calls
try:
    response = make_api_call(...)
except ProviderError as e:
    logger.error(f"Provider error: {e}")
    # Implement retry logic or fallback
except ContentRefusalError as e:
    logger.warning(f"Content refused: {e}")
    # Handle refusal gracefully
except Exception as e:
    logger.error(f"Unexpected error: {e}")
    # Generic error handling
```

### Testing Requirements
```python
# All API calls must be properly mocked in tests
@pytest.fixture
def mock_openai_response():
    """Mock OpenAI Responses API response."""
    return {
        "output_text": "Test response",
        "usage": {
            "prompt_tokens": 10,
            "completion_tokens": 20,
            "total_tokens": 30
        }
    }

def test_api_call(mock_openai_response, monkeypatch):
    """Test API call with proper mocking."""
    monkeypatch.setattr(requests, 'post', lambda *args, **kwargs: mock_openai_response)
    result = make_api_call("openai", "gpt-4.1", "test prompt")
    assert result["content"] == "Test response"
```

