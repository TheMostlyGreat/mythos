        "max_tokens": 1024,
        "tools": [json_tool],
        "tool_choice": {"type": "tool", "name": "structured_response"},
        "messages": [
            {"role": "user", "content": "Analyze this business scenario"}
        ]
    }
)
```

### Refusal Handling

```python
def handle_anthropic_response(response):
    """Handle Anthropic API responses with refusal detection."""
    content = response.json()["content"][0]["text"]
    
    # Check for common refusal patterns
    refusal_indicators = [
        "I can't assist with",
        "I'm not able to",
        "I don't feel comfortable",
        "That request could be harmful"
    ]
    
    is_refusal = any(indicator in content for indicator in refusal_indicators)
    
    if is_refusal:
        return {"type": "refusal", "message": content}
    else:
        return {"type": "success", "content": content}
```

